{
  "name": "dsh-minimax-web-api",
  "version": "0.1.0",
  "description": "minimaxcode2api (MiniMax Agent 反代) 作为 DSH 的 LLM 提供方接入模型选择器",
  "type": "module",
  "main": "lib/provider.js",
  "exports": {
    ".": "./lib/provider.js",
    "./provider": "./lib/provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.ps1",
    "README.md"
  ],
  "scripts": {
    "test": "node test/config_check.mjs && node test/smoke.mjs",
    "test:config": "node test/config_check.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:runtime": "node test/preparecall_regression.mjs",
    "install-plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "minimax",
    "minimax2api",
    "provider",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "Apache-2.0"
}